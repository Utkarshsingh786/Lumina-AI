# ─── App ──────────────────────────────────────────────
APP_NAME="Lumina AI"
APP_ENV=development                    # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
APP_VERSION=0.1.0

# ─── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1                              # increase in production

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lumina:lumina_pass@localhost:5432/lumina_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600                   # 1 hour default cache TTL

# ─── Auth ─────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ─── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── AI Providers ─────────────────────────────────────
# Provider is resolved automatically from the model id you select in the UI.
# No DEFAULT_AI_PROVIDER needed — just configure the providers you want to use.
# DEFAULT_CHAT_MODEL is the fallback only for API clients that omit the model field.

# ── OpenAI (paid) ──────────────────────────────────────
OPENAI_API_KEY=sk-...
DEFAULT_CHAT_MODEL=gpt-4o
DEFAULT_FAST_MODEL=gpt-4o-mini
DEFAULT_EMBED_MODEL=text-embedding-3-small

# ── Anthropic (paid) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── OpenRouter (FREE tier available — no credit card needed) ──
# Sign up free at https://openrouter.ai and create an API key.
# Free models (e.g. llama-3.1-8b:free) cost $0 with rate limits.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default, no need to change

# ── Groq (ultra-fast inference, free tier available) ──
# Sign up: https://console.groq.com | Free: 14,400 req/day on llama-3.1-8b
GROQ_API_KEY=gsk_...
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# ── Google Gemini (free tier: 15 RPM, 1M TPM on Flash) ──
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── Ollama (100% free, runs locally) ──────────────────
# Install: https://ollama.com/download
# Pull a model: ollama pull llama3.2
# Then enable below and set DEFAULT_AI_PROVIDER=ollama
OLLAMA_ENABLED=false
# Local (running outside Docker): http://localhost:11434
# Inside Docker Compose:          http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text    # ollama pull nomic-embed-text (for RAG)

# ─── Voice (STT / TTS) ────────────────────────────────
# Requires OPENAI_API_KEY. Whisper for transcription, OpenAI TTS for synthesis.
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1               # tts-1 (fast) | tts-1-hd (high quality)
VOICE_TTS_VOICE=alloy               # alloy | echo | fable | onyx | nova | shimmer

# ─── AI Behavior ──────────────────────────────────────
MAX_CONTEXT_TOKENS=128000
CONTEXT_RESERVE_TOKENS=2000            # reserve for response
SUMMARY_TRIGGER_MESSAGES=30            # summarize after N messages
MEMORY_EXTRACTION_ENABLED=true

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=100

# ─── File Uploads ─────────────────────────────────────
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=["application/pdf","text/plain","text/markdown","image/png","image/jpeg"]
STORAGE_BACKEND=local                  # local | s3
LOCAL_STORAGE_PATH=./uploads
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ─── Celery ───────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | pretty
